__pycache__/
*.pyc
.env
.venv/
.venv_win/
venv/
.pytest_cache/
logs/

# Raw PLATEAU CityGML can run into the hundreds of MB per municipality;
# only the derived buildings_footprints.parquet extract is tracked.
data/raw/plateau/

# NLNI hazard-layer metadata XML sidecars are never read by
# src/data_sources/hazards.py (only .shp/.dbf/.geojson are) and account for
# ~154MB of dead weight (A33-18_43.xml alone is 97MB) — exclude before this
# folder is ever committed.
data/raw/hazards/**/*.xml
