# Copy this file to .env and fill in your own keys. .env is gitignored.

# MLIT Real Estate Information Library (reinfolib) API key.
# Register for free at: https://www.reinfolib.mlit.go.jp/api/request
# Used by src/data_sources/transactions.py for actual transaction-price data.
REINFOLIB_API_KEY=

# e-Stat (Japan Statistics Bureau) application ID.
# Register for free at: https://www.e-stat.go.jp/api/
# Used by src/data_sources/demographics.py and src/data_sources/akiya.py.
ESTAT_APP_ID=
